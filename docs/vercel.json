{
  "cleanUrls": true,
  "redirects": [
    { "source": "/eula", "destination": "/terms", "permanent": true }
  ],
  "headers": [
    {
      "source": "/download/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
